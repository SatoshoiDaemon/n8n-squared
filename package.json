{
	"name": "squared",
	"version": "0.1.0",
	"private": true,
	"description": "Workflow automation for Square Cloud",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/main.js",
		"dev": "node --watch src/main.js",
		"build": "node scripts/squared/check-runtime.mjs && npm run typecheck",
		"build:deploy": "npm run package:squarecloud",
		"package:squarecloud": "node scripts/squared/package-squarecloud.mjs",
		"verify:squarecloud": "node scripts/squared/verify-squarecloud.mjs",
		"smoke:squarecloud": "node scripts/squared/smoke-squarecloud.mjs",
		"deploy:squarecloud": "node scripts/squared/deploy-squarecloud.mjs",
		"inspect:squarecloud": "node scripts/squared/inspect-squarecloud.mjs",
		"compatibility:matrix": "node scripts/compatibility/generate-node-matrix.mjs",
		"n8n:install": "node scripts/compatibility/install-n8n-packages.mjs",
		"compatibility:validate": "node scripts/compatibility/validate-installed-nodes.mjs",
		"compatibility:benchmark": "node --expose-gc scripts/compatibility/benchmark-engine.mjs",
		"compatibility:benchmark:n8n": "node --expose-gc scripts/compatibility/benchmark-n8n-runtime.mjs",
		"typecheck": "tsc --project tsconfig.squared.json",
		"test": "node --test src/*.test.js src/**/*.test.js"
	},
	"dependencies": {
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^5.9.3"
	}
}
